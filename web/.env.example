# web에 공개할 호스트 포트
WEB_PORT=8080
# PostgreSQL 데이터베이스 이름 (기존 볼륨 생성 후 변경 시 별도 DB 이전 필요)
POSTGRES_DB=exaone
# PostgreSQL 사용자 이름
POSTGRES_USER=exaone
# PostgreSQL 암호 (실제 배포 시 변경)
POSTGRES_PASSWORD=exaone-local-password
# API 키 암호화 비밀값; 비워 두면 apidata 볼륨에 자동 생성·보존
APP_SECRET=
# HTTPS 배포에서 true로 설정하면 세션 쿠키에 Secure 적용
COOKIE_SECURE=false
# 새 세션에 적용할 기본 업스트림 Base URL
DEFAULT_BASE_URL=https://api.exaone.ai/v1
# 새 세션에 적용할 기본 모델
DEFAULT_MODEL=k-exaone_v2.5
# 제안할 모델 목록을 쉼표로 구분 (자유 입력 가능)
MODELS=k-exaone_v2.5,LGAI-EXAONE/K-EXAONE-2.0-750B-A37B,LGAI-EXAONE/K-EXAONE-236B-A23B
# reasoning_effort를 사용하는 공식 EXAONE 방식 호스트 목록
EXAONE_STYLE_HOSTS=api.exaone.ai
# 허용할 업스트림 Base URL을 쉼표로 구분
ALLOWED_BASE_URLS=https://api.exaone.ai/v1,https://api.friendli.ai/serverless/v1
# 임의의 http(s) Base URL 허용 여부
ALLOW_CUSTOM_BASE_URL=false
# 웹 백엔드가 사용할 검색 서버 주소 (관리자 환경변수 전용)
SEARXNG_URL=http://searxng:8080
# Windows 앱·MCP용 검색 포트 (127.0.0.1에만 바인딩)
SEARXNG_PORT=8888
# 로컬 전용 기본값이며 직접 설치에서는 임의의 비밀값으로 변경
SEARXNG_SECRET=exaone-local-only-search-secret-change-me
